# All values are optional; these are the defaults.
MENUMATCH_DATA_DIR=./data
MENUMATCH_SEED=7
MENUMATCH_N_DAYS=120
MENUMATCH_ORDERS_PER_DAY=300

# Artifact store: "local" (filesystem mirror of the bucket layout) or "s3"
MENUMATCH_STORE=local
MENUMATCH_LOCAL_STORE_DIR=./artifacts
MENUMATCH_S3_BUCKET=menumatch-artifacts
# Point at a local moto server (moto_server -p 5000) -- never a real account.
MENUMATCH_S3_ENDPOINT=http://localhost:5000
# Dummy credentials accepted by moto; not real secrets.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# Prefix under which models are registered
MENUMATCH_REGISTRY_NAME=menumatch
